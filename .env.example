# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values. Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at
# BUILD time, so it is public and changing it in Vercel needs a redeploy.

# --- Scholarship intake (/apply) -------------------------------------------
# Each application becomes a task in ClickUp: Grassroots Foundation workspace →
# Scholarships → Applications. Without both of these the form renders but
# returns its error state on submit rather than silently dropping an
# application. See docs/clickup-setup.md.
CLICKUP_API_TOKEN=
CLICKUP_APPLICATIONS_LIST_ID=

# --- Analytics --------------------------------------------------------------
# Inert until set. Gated behind analytics consent by Consent Mode v2.
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity project id (Clarity: Settings, Setup). Loads only after a
# visitor allows analytics, and only in production.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Donations --------------------------------------------------------------
# Zeffy form URL. The donate flow renders nothing until this is set.
NEXT_PUBLIC_ZEFFY_FORM_URL=
