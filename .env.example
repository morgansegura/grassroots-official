# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values. Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at
# BUILD time, so it is public and changing it in Vercel needs a redeploy.

# --- Scholarship intake (/apply) -------------------------------------------
# Applications post to a Monday board that doubles as the review pipeline and
# audit trail. Without both of these the form renders but returns its error
# state on submit rather than silently dropping an application.
#
# Board columns are resolved BY TITLE and must match exactly — see
# docs/scholarship-review-process.md and lib/apply/submit.ts:
#   Status (status: New / Under review / Documentation requested /
#           Approved / Declined), Applicant Name, Relationship, Email, Phone,
#   Player Birth Year, Club, Household Size, Income Bracket, Assistance,
#   Costs Requested, Described Need (long text), Language
MONDAY_API_KEY=
MONDAY_APPLICATIONS_BOARD_ID=

# --- Analytics --------------------------------------------------------------
# Inert until set. Gated behind analytics consent by Consent Mode v2.
NEXT_PUBLIC_GTM_ID=

# --- Donations --------------------------------------------------------------
# Zeffy form URL. The donate flow renders nothing until this is set.
NEXT_PUBLIC_ZEFFY_FORM_URL=
